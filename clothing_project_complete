## 4. What is the correlation between browsing history and purchase history?
We will calculate the histogram similarity between the two lists per customer and visualize the distribution.
"""

import matplotlib.pyplot as plt
from sklearn.feature_extraction.text import CountVectorizer
from sklearn.metrics.pairwise import cosine_similarity

# Convert lists into space-separated strings
df["Browsing_History_str"] = df["Browsing_History"].apply(lambda x: " ".join(x))
df["Purchase_History_str"] = df["Purchase_History"].apply(lambda x: " ".join(x))

# Convert text data to vector counts
vectorizer = CountVectorizer()
X = vectorizer.fit_transform(df["Browsing_History_str"])
Y = vectorizer.transform(df["Purchase_History_str"])

# Compute Cosine Similarity
cosine_scores = [cosine_similarity(X[i], Y[i])[0][0] for i in range(len(df))]

# Simple histogram
plt.hist(cosine_scores, bins=10, color="skyblue", edgecolor="black")
plt.xlabel("Cosine Similarity Score")
plt.ylabel("Number of Customers")
plt.title("Browsing vs. Purchase History Correlation")
plt.show()

